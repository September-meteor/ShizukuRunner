<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    >

    <Switch
        android:id="@+id/s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hide_from_recents"
        android:padding="16dp"/>

    <Switch
        android:id="@+id/s1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enable_50_commands"
        android:padding="16dp"/>

    <Switch
        android:id="@+id/lang_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/language_switch"
        android:padding="16dp"/>

    <!-- 多行命令模式开关（替代原来的实验性功能+切换按钮） -->
    <Switch
        android:id="@+id/multi_line_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/multi_line_mode"
        android:padding="10dp" />

    <Switch
        android:id="@+id/auto_wrap_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_wrap_experimental"
        android:padding="10dp"
        android:checked="true" />

    <!-- 配置管理区：离上方开关近一点，离页面底部远一点 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/import_config"
            style="@style/btn_outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:drawableStart="@drawable/ic_import"
            android:drawablePadding="2dp"
            android:maxLines="1"
            android:text="@string/import_config" />

        <Button
            android:id="@+id/edit_env"
            style="@style/btn_outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_env"
            android:drawablePadding="2dp"
            android:maxLines="1"
            android:text="@string/edit_env" />
    </LinearLayout>

    <Button
        android:id="@+id/export_config"
        style="@style/btn_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:drawableStart="@drawable/ic_export"
        android:drawablePadding="2dp"
        android:maxLines="1"
        android:text="@string/export_config" />
</LinearLayout>